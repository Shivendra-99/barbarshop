# Copy to `.env` and fill in. Everything has a safe local default except secrets.

# --- Server ---
PORT=4000
# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Database ---
# Your MongoDB Atlas connection string. Leave BLANK to run an in-memory MongoDB
# for local development (data resets on restart) — handy before Atlas is set up.
# Example: mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/salonsathi?retryWrites=true&w=majority
MONGODB_URI=

# --- Auth ---
# CHANGE THIS. Any long random string; it signs the login tokens.
JWT_SECRET=dev-only-change-me-to-a-long-random-string
# How long a login lasts. Spec: remembered for 30 days.
JWT_EXPIRES_IN=30d

# --- OTP (dev flow) ---
# Used only when MSG91 below is NOT configured. Then a random code is stored
# locally and returned in the API response so you can log in without SMS.
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_DEV_RETURN=true

# --- MSG91 Server OTP API (real SMS) ---
# Fill BOTH authkey and template_id to switch from the dev flow to real SMS.
# MSG91 then generates, sends and verifies the code; nothing is stored locally.
#   authkey     : MSG91 panel → Settings → API keys
#   template_id : MSG91 panel → OTP → your DLT-approved OTP template
#   sender_id   : your registered 6-char DLT header (optional if the template has one)
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_OTP_EXPIRY_MINUTES=15

# --- Payments (stubbed until filled) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
